# Uploaded PDFs are only ever served through the authenticated
# download.php script (which checks the visitor's role and class before
# handing over the file). Direct browser access to this folder is blocked
# entirely so access control can't be bypassed by guessing/sharing a URL.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Extra safety net: even if the deny rule above is ever misconfigured,
# never execute anything in this folder as a script.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
